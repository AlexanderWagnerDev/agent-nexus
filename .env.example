# Copy to .env and adjust for your deployment.
HUB_DOMAIN=nexus.example.com
HUB_NAME=AgentNexus

# Pinned release (recommended). Use NEXUS_TAG=latest only if you deliberately
# want the rolling channel; then set WUD_WATCH_DIGEST=true.
NEXUS_TAG=v0.3.3-rc.1
WUD_WATCH_DIGEST=false

# Portainer standalone stack. Bind to loopback when the proxy runs on the same
# host; use 0.0.0.0 only when the proxy is on another machine and the port is
# protected by a firewall.
HUB_PORT=8787
HUB_BIND=127.0.0.1

# Exact name of an existing proxy network for the -proxy variant.
PROXY_NETWORK=npm_proxy

# Optional IPv6 bridge ranges (your Docker daemon must have IPv6 enabled).
NEXUS_IPV4_SUBNET=172.30.0.0/24
NEXUS_IPV6_SUBNET=fd42:6e78:6578::/64

TZ=UTC
